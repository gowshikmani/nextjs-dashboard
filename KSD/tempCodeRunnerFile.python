import numpy as np

ar = np.array(
    [
        [1,6,2,3],
        [2,7,1,6],
        [3,3,1,2],
        [7,8,1,5]
    ]
)

ar2 = np.array(
    [
        [5,3,1,1],
        [2,3,5,1],
        [9,8,6,2],
        [3,3,1,4]
    ]
)

ar3 = ar+ar2
ar4 = ar-ar2
ar5 = ar*ar2
ar6 = ar/ar2
ar7 = ar@ar2
ar8 = ar**ar2
ar9 = ar%ar2
ar10 = ar//ar2
print(ar3,"\n",ar4,"\n",ar5,"\n",ar6,"\n",ar7,"\n",ar8,"\n",ar9,"\n",ar10)