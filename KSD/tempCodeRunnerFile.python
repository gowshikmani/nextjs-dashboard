import pandas as pd
import random as rd

Students_name = [
    'Lucia Caminos',
    'Jason Duval',
    'Niko Bellic',
    'Carl Johnson',
    'Tommy Vercetti',
    'Claude',
    'Michael De Santa',
    'Franklin Clinton',
    'Trevor Philips',
    'John Marston',
    'Arthur Morgan',
    'Toni Cipriani',
    'Victor Vance',
    'Luis Lopez',
    'Johnny Klebitz',
    'Jimmy Hopkins',
    'Huang Lee',
    'Mike'
]

# Alphabetical order
Students_name = sorted(Students_name)

# Generate IDs according to alphabetical order
Students_id = [
    f"AD117{i:03d}"
    for i in range(1, len(Students_name) + 1)
]

# Generate emails
Students_email = [
    f"{name.lower().replace(' ', '.')} .{student_id}@gta.in".replace(" ", "")
    for name, student_id in zip(Students_name, Students_id)
]

# Generate phone numbers
Students_phone = [
    f"+1-555-{rd.randint(100, 999)}-{rd.randint(1000, 9999)}"
    for _ in Students_name
]

detail = pd.DataFrame({
    'Students_name': Students_name,
    'Students_id': Students_id,
    'Students_email': Students_email,
    'Students_phone': Students_phone
})

print(detail)
to_csv = input("Do you want to save the data to a CSV file? (yes/no): ").strip().lower()
if to_csv == 'yes' or to_csv == 'y' or to_csv == 'sure':
    filename = input("Enter the filename (with .csv extension): ").strip()
    detail.to_csv(filename, index=False)
    print(f"Data saved to {filename}")